{
  "manifest_version": 3,
  "name": "Angel Memos Capture",
  "version": "0.2.0",
  "description": "One-click capture of an AngelList deal page + deck + attachments into Downloads/angel-memos/<Company>/ for the angel-memos watcher.",
  "permissions": ["downloads", "debugger", "activeTab", "tabs"],
  "host_permissions": ["https://*.angellist.com/*", "https://*.angel.co/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.angellist.com/*", "https://*.angel.co/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
